# Django environment variables example file
SECRET_KEY="your-super-secret-django-key"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration
# Dev uses SQLite by default, production reads DB_URL or individual configs below:
DB_NAME="fitness_db"
DB_USER="fitness_admin"
DB_PASSWORD="secure_strength_pass"
DB_HOST="db"
DB_PORT=5432

# Third-party APIs (Optional custom overrides)
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest/USD"
MOTIVATION_API_URL="https://zenquotes.io/api/random"
